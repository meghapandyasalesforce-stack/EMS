{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:ci": "npm test",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest --testPathPattern=tests/unit",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest --testPathPattern=tests/integration",
    "build": "cd ../vite_client && npm install && npm run build:deploy",
    "check-email": "node scripts/check-email-config.js",
    "test-mongodb": "node test-mongodb.js",
    "check-user": "node scripts/checkUser.js",
    "list-users": "node scripts/checkUser.js --list",
    "create-user": "node scripts/createTestUser.js",
    "test-login": "node scripts/testLoginEndpoint.js",
    "test-password": "node scripts/testPassword.js",
    "generate-vapid-keys": "node scripts/generate-vapid-keys.js",
    "setup-redis": "bash scripts/setup-redis.sh"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@googlemaps/google-maps-services-js": "^3.4.2",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.22.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.18.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "i18next": "^23.15.1",
    "i18next-fs-backend": "^2.3.1",
    "imapflow": "^1.5.0",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^4.1.0",
    "luxon": "^3.7.2",
    "mongoose": "^8.14.2",
    "multer": "^1.4.5-lts.2",
    "node-cron": "^3.0.3",
    "nodemailer": "^7.0.3",
    "pdf-parse": "^2.3.12",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "redis": "^4.6.13",
    "sharp": "^0.34.4",
    "socket.io": "^4.8.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "web-push": "^3.6.7",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "supertest": "^6.3.4"
  },
  "optionalDependencies": {
    "@sentry/node": "^8.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "transform": {},
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/tests/"
    ]
  }
}
