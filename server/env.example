# Database Configuration
MONGO_URI=mongodb://localhost:27017/paarsiv_hr

# Server Configuration
# Default port is 10000 (matches Vite proxy configuration)
PORT=10000
NODE_ENV=development

# Frontend Configuration
# CRITICAL: This URL is used for all email links (password reset, welcome emails)
# Development: http://localhost:5173
# Production: Set to your actual domain (e.g., https://yourdomain.com)
# For local development, use:
FRONTEND_URL=http://localhost:5173
# Public https app URL for push icons/deep links on real phones
PUBLIC_APP_URL=https://yourdomain.com
# For production (Hostinger/Vercel/etc.), change to:
# FRONTEND_URL=https://yourdomain.com
# IMPORTANT: Must use HTTPS in production and match your actual frontend domain

# Backend Configuration
# Used for email logo URLs and other backend-hosted assets
# Development: http://localhost:10000
# Production: Set to your actual backend domain (e.g., https://your-backend.onrender.com)
# For local development, use:
BACKEND_URL=http://localhost:10000
# For production (Render/other hosting), change to:
# BACKEND_URL=https://your-backend-domain.com

# Additional Allowed Origins (comma-separated)
# For multiple frontend deployments or testing
# Example: ALLOWED_ORIGINS=https://paarsiv.vercel.app,https://staging.vercel.app
ALLOWED_ORIGINS=

# JWT Configuration
# WARNING: Generate a strong random secret for production (minimum 32 characters)
# Use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_this_to_a_strong_random_secret_min_32_characters

# JWT Token Expiration
# Access token expiration (short-lived for security)
# Examples: "15m", "30m", "1h", "2h"
JWT_ACCESS_EXPIRE=1h

# Refresh token expiration (long-lived)
# Examples: "7d", "30d", "90d"
JWT_REFRESH_EXPIRE=30d

# Legacy: JWT_EXPIRE (deprecated, use JWT_ACCESS_EXPIRE instead)
# JWT_EXPIRE=7d

# Cookie/Domain Configuration
# Set CROSS_SITE_COOKIES=true if frontend is on a different site and you need SameSite=None cookies
# Required for production when frontend (Vercel) and backend (Render) are on different domains
# For local development (same origin via proxy), you can set to false
CROSS_SITE_COOKIES=false
# Optional cookie domain for production (e.g., .example.com)
# Leave empty for local development
DOMAIN=

# Email Configuration (for password reset and notifications)
# 
# IMPORTANT: For Gmail, you MUST use an App Password, not your regular password!
# 1. Enable 2-Step Verification: https://myaccount.google.com/security
# 2. Generate App Password: https://myaccount.google.com/apppasswords
# 3. Use the 16-character App Password as EMAIL_PASS
# 4. Do NOT set EMAIL_HOST for Gmail - it will auto-detect
#
# For Gmail:
# EMAIL_USER=yourname@gmail.com
# EMAIL_PASS=xxxx xxxx xxxx xxxx  # App Password (16 chars)
# # EMAIL_HOST not needed for Gmail
#
# For Outlook/Office 365:
EMAIL_HOST=smtp.office365.com
EMAIL_PORT=587
EMAIL_USER=your_email@outlook.com
EMAIL_PASS=your_email_password_here
#
# For other SMTP servers:
# EMAIL_HOST=smtp.yourprovider.com
# EMAIL_PORT=587  # or 465 for SSL
# EMAIL_USER=your_email@example.com
# EMAIL_PASS=your_password

# File Upload Configuration
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# Default Password for New Employees
# SECURITY: This setting has been removed for security reasons.
# The system now generates unique, secure passwords for each new employee automatically.
# Passwords are sent via email to the employee upon account creation.

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
# Disable rate limiting in development (set to 'true' to disable)
# WARNING: Only use in development! Never set to 'true' in production.
# If you experience 429 errors in development, set this to 'true'
DISABLE_RATE_LIMIT=false

# Email Configuration Aliases
EMAIL_USERNAME=your_email@example.com
EMAIL_PASSWORD=your_email_password_here
EMAIL_FROM=your_email@example.com

# Push Notification Configuration (Web Push API)
# Generate VAPID keys using: npx web-push generate-vapid-keys
# VAPID_SUBJECT should be a mailto: URL or a URL to your site
# IMPORTANT (production): set the SAME key pair on the production host.
# Regenerating keys invalidates all existing device subscriptions.
# Each device must grant notification permission and subscribe separately.
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
# Optional alias used by some legacy routes (prefer VAPID_SUBJECT)
# VAPID_EMAIL=mailto:admin@example.com
# Note: If not configured, push notifications will be disabled but system will continue to work

# Redis Configuration (for caching and job queues)
# REQUIRED for job queues (email, notifications)
# OPTIONAL for caching (system works without it, but slower)
# Install Redis: 
#   - Windows: Download from https://redis.io/download or use WSL
#   - Mac: brew install redis
#   - Linux: sudo apt-get install redis-server
# Start Redis: redis-server (or brew services start redis on Mac)
# Default: redis://localhost:6379
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# Note: If Redis is not running, system will continue but job queues won't work

# Job Queue Configuration
# Requires Redis to be running
QUEUE_CONCURRENCY=5
QUEUE_MAX_ATTEMPTS=3
QUEUE_BACKOFF_DELAY=5000

# Request Timeout Configuration
# Maximum time a request can take before timing out (in milliseconds)
# Default: 30000 (30 seconds)
REQUEST_TIMEOUT_MS=30000

# Database Query Logging
# Enable slow query logging (default: true)
ENABLE_QUERY_LOGGING=true
# Threshold for slow queries in milliseconds (default: 1000ms)
SLOW_QUERY_THRESHOLD_MS=1000
# Enable detailed query debugging in development (default: false)
DEBUG_QUERIES=false

# ==================== OPTIONAL FEATURES ====================

# Swagger API Documentation
# Set to 'true' to enable Swagger in production (disabled by default for security)
# In development, Swagger is automatically enabled
ENABLE_SWAGGER=false

# Prometheus Metrics (Monitoring)
# Set to 'true' to expose /metrics endpoint for Prometheus scraping
# Requires prom-client to be installed: npm install prom-client
# WARNING: In production, restrict access to /metrics at the infrastructure level (IP allowlist, auth proxy, etc.)
ENABLE_METRICS=false

# ==================== GOOGLE MAPS API CONFIGURATION ====================
# Google Maps API Key (for location features - FREE TIER AVAILABLE)
# 
# SETUP INSTRUCTIONS:
# 1. Go to: https://console.cloud.google.com/
# 2. Create/Select a project
# 3. Enable billing (required, but free tier applies - won't be charged until you exceed limits)
# 4. Enable these APIs:
#    - Maps JavaScript API: https://console.cloud.google.com/apis/library/maps-backend.googleapis.com
#    - Geocoding API: https://console.cloud.google.com/apis/library/geocoding-backend.googleapis.com
#    - Places API: https://console.cloud.google.com/apis/library/places-backend.googleapis.com
# 5. Create API Key: APIs & Services → Credentials → Create Credentials → API Key
# 6. Restrict API Key (Recommended):
#    - Application restrictions: HTTP referrers (add localhost:* and your domain)
#    - API restrictions: Restrict to Maps JavaScript API, Geocoding API, Places API
# 7. Add the same key to both variables below
# 8. Test: Run 'node server/scripts/test-google-maps-api.js'
#
# FREE TIER LIMITS (2025):
# - Maps JavaScript API: ~28,000 map loads/month
# - Geocoding API: 40,000 requests/month
# - Places API: ~11,700 requests/month
# Estimated cost for typical HRMS: $0/month
#
# For detailed setup guide, see: GOOGLE_MAPS_SETUP.md
# Required for: Location picker, address autocomplete, map features, geocoding
# Frontend uses VITE_GOOGLE_MAPS_API_KEY (exposed to browser)
# Backend uses GOOGLE_MAPS_API_KEY (server-side only, more secure)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Admin Registration
# Set to 'true' to allow admin registration in production (disabled by default for security)
# In development, admin registration is automatically enabled
VITE_ALLOW_REGISTRATION=false