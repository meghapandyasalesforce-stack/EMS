# Database Configuration
MONGO_URI=mongodb://localhost:27017/paarsiv_hr

# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend Configuration
# Development: http://localhost:5173
# Production: https://paarsiv.vercel.app (Vercel deployment)
FRONTEND_URL=https://paarsiv.vercel.app

# Additional Allowed Origins (comma-separated)
# For multiple frontend deployments or testing
# Example: ALLOWED_ORIGINS=https://paarsiv.vercel.app,https://staging.vercel.app
ALLOWED_ORIGINS=

# JWT Configuration
# WARNING: Generate a strong random secret for production (minimum 32 characters)
# Use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_this_to_a_strong_random_secret_min_32_characters
JWT_EXPIRE=7d

# Cookie/Domain Configuration
# Set CROSS_SITE_COOKIES=true if frontend is on a different site and you need SameSite=None cookies
# Required for production when frontend (Render) and backend are on different domains
CROSS_SITE_COOKIES=true
# Optional cookie domain for production (e.g., .example.com)
DOMAIN=

# Email Configuration (for password reset and notifications)
# For Outlook/Office 365: smtp.office365.com
# For Gmail: smtp.gmail.com
EMAIL_HOST=smtp.office365.com
EMAIL_PORT=587
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_password_here

# File Upload Configuration
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# Default Password for New Employees
# SECURITY: This setting has been removed for security reasons.
# The system now generates unique, secure passwords for each new employee automatically.
# Passwords are sent via email to the employee upon account creation.

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Email Configuration Aliases
EMAIL_USERNAME=your_email@example.com
EMAIL_PASSWORD=your_email_password_here
EMAIL_FROM=your_email@example.com

# Push Notification Configuration (Web Push API)
# Generate VAPID keys using: npx web-push generate-vapid-keys
# VAPID_SUBJECT should be a mailto: URL or a URL to your site
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here