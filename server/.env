# JWT Token Expiration
# Access token expiration (short-lived for security)
# Examples: "15m", "30m", "1h", "2h"
JWT_ACCESS_EXPIRE=1h

# Refresh token expiration (long-lived)
# Examples: "7d", "30d", "90d"
JWT_REFRESH_EXPIRE=30d

# Legacy: JWT_EXPIRE (deprecated, use JWT_ACCESS_EXPIRE instead)
# JWT_EXPIRE=7d

# Cookie/Domain Configuration
# Set CROSS_SITE_COOKIES=true if frontend is on a different site and you need SameSite=None cookies
# Required for production when frontend (Vercel) and backend (Render) are on different domains
# For local development (same origin via proxy), you can set to false
# Use false for localhost; set true + DOMAIN when frontend/backend are on different production domains
CROSS_SITE_COOKIES=false
# Optional cookie domain for production (e.g., .example.com)
# Leave empty/unset for local development
# DOMAIN=employeehub.cloud

