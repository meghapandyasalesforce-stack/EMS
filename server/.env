# Database Configuration
MONGO_URI=mongodb+srv://kunalpareekn:Ax7dVdoZ42LbqKiG@cluster0.lxwkmke.mongodb.net/EMS?retryWrites=true&w=majority&appName=Cluster0

# Server Configuration
# Default port is 10000 (matches Vite proxy configuration)
PORT=10000
NODE_ENV=development

# Frontend Configuration
# Development: http://localhost:5173
# Production: https://paarsiv.vercel.app (Vercel deployment)
# For local development, use:
FRONTEND_URL=http://localhost:5173
# For production, change to:
# FRONTEND_URL=https://paarsiv.vercel.app

# Additional Allowed Origins (comma-separated)
# For multiple frontend deployments or testing
# Example: ALLOWED_ORIGINS=https://paarsiv.vercel.app,https://staging.vercel.app
ALLOWED_ORIGINS=

# JWT Configuration
# WARNING: Generate a strong random secret for production (minimum 32 characters)
# Use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=b69f6c9b2d2ede891793bc369e62b3dcdcb6c0c7847c7a3064a4d9ee11ede4455e104f00adad96851188a4a57529b8b1d650e1689b0b3269cfce75e902dc4528

# JWT Token Expiration
# Access token expiration (short-lived for security)
# Examples: "15m", "30m", "1h", "2h"
JWT_ACCESS_EXPIRE=1h

# Refresh token expiration (long-lived)
# Examples: "7d", "30d", "90d"
JWT_REFRESH_EXPIRE=30d

# Legacy: JWT_EXPIRE (deprecated, use JWT_ACCESS_EXPIRE instead)
# JWT_EXPIRE=7d

# Cookie/Domain Configuration
# Set CROSS_SITE_COOKIES=true if frontend is on a different site and you need SameSite=None cookies
# Required for production when frontend (Vercel) and backend (Render) are on different domains
# For local development (same origin via proxy), you can set to false
CROSS_SITE_COOKIES=false
# Optional cookie domain for production (e.g., .example.com)
# Leave empty for local development
DOMAIN=

# Email Configuration (for password reset and notifications)
# 
# IMPORTANT: For Gmail, you MUST use an App Password, not your regular password!
# 1. Enable 2-Step Verification: https://myaccount.google.com/security
# 2. Generate App Password: https://myaccount.google.com/apppasswords
# 3. Use the 16-character App Password as EMAIL_PASS
# 4. Do NOT set EMAIL_HOST for Gmail - it will auto-detect
#
# For Gmail:
# EMAIL_USER=yourname@gmail.com
# EMAIL_PASS=xxxx xxxx xxxx xxxx  # App Password (16 chars)
# # EMAIL_HOST not needed for Gmail

#
## Gmail SMTP Configuration
EMAIL_USER=kunalpareekn@gmail.com
EMAIL_PASS=ymac hebq jdly wrks
EMAIL_HOST=gmail
EMAIL_PORT=587
EMAIL_FROM=kunalpareekn@gmail.com

# File Upload Configuration
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# Default Password for New Employees
# SECURITY: This setting has been removed for security reasons.
# The system now generates unique, secure passwords for each new employee automatically.
# Passwords are sent via email to the employee upon account creation.

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Email Configuration Aliases
EMAIL_USERNAME=your_email@example.com
EMAIL_PASSWORD=your_email_password_here
EMAIL_FROM=your_email@example.com

# Push Notification Configuration (Web Push API)
# Generate VAPID keys using: npx web-push generate-vapid-keys
# VAPID_SUBJECT should be a mailto: URL or a URL to your site
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here

