# Razorpay SaaS billing
# Empty keys → local mock checkout (card 4242…).
# With keys → Razorpay Subscriptions (recurring) by default.

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CURRENCY=INR

# Optional: mock | razorpay
# RAZORPAY_BILLING_MODE=razorpay

# Checkout: subscription (default, recurring) | order (one-time)
# RAZORPAY_CHECKOUT_MODE=subscription

# How many monthly cycles to create (default 120 ≈ 10 years)
# RAZORPAY_SUBSCRIPTION_TOTAL_COUNT=120

# Optional: reuse Dashboard plans instead of auto-creating
# RAZORPAY_PLAN_ID_BASIC=plan_xxx
# RAZORPAY_PLAN_ID_PREMIUM=plan_xxx
# RAZORPAY_PLAN_ID_ENTERPRISE=plan_xxx

# Webhook URL (Dashboard → Webhooks) — enable these events:
#   subscription.activated, subscription.charged, subscription.pending,
#   subscription.halted, subscription.cancelled, subscription.completed,
#   payment.captured, payment.failed, order.paid
#   POST {API_BASE}/api/v1/webhooks/razorpay

# Seller block on invoice PDFs. Leave GSTIN empty for a payment receipt (no tax lines).
# Amount charged is the invoice total. If GSTIN is set, GST is shown as included (default 18%).
# BILLING_LEGAL_NAME=Paarsiv Technologies Pvt Ltd
# BILLING_ADDRESS=Bengaluru, Karnataka, India
# BILLING_GSTIN=
# BILLING_EMAIL=billing@example.com
# BILLING_SUPPORT_EMAIL=support@example.com
# BILLING_GST_RATE=18
